APP_NAME=TokenGuard AI
APP_VERSION=1.5.0
ENVIRONMENT=development
DEBUG=true

LOG_LEVEL=INFO
LOG_FORMAT=json

ENABLE_PROMETHEUS_METRICS=true
METRICS_PATH=/metrics

ENABLE_OPENTELEMETRY=true
OTEL_SERVICE_NAME=tokenguard-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

PROVIDER_RETRY_ENABLED=true
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_MIN_WAIT_SECONDS=1
PROVIDER_RETRY_MAX_WAIT_SECONDS=8

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

PROVIDER_HEALTH_WINDOW_MINUTES=15
PROVIDER_UNHEALTHY_SCORE_THRESHOLD=40

DATABASE_URL=postgresql+psycopg://tokenguard:change_me@localhost:5433/tokenguard
TEST_DATABASE_URL=postgresql+psycopg://tokenguard:change_me@localhost:5433/tokenguard_test

REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
REDIS_CACHE_TTL_SECONDS=86400
REDIS_RATE_LIMIT_PREFIX=tokenguard:rate-limit
REDIS_EXACT_CACHE_PREFIX=tokenguard:exact-cache

USE_REDIS_EXACT_CACHE=true
USE_REDIS_RATE_LIMITING=true

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

REQUEST_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VERSION=2023-06-01

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b

MODEL_PRICING_FILE=config/model_pricing.json

TOKEN_GUARD_MASTER_KEY=
CREDENTIAL_TEST_TIMEOUT_SECONDS=20

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_MAX_CANDIDATES=500

ROUTING_POLICY_FILE=config/routing_policy.json
AUTO_ROUTING_ENABLED=true

BUDGET_POLICY_FILE=config/budget_policy.json
BUDGET_ENFORCEMENT_ENABLED=true
RATE_LIMITING_ENABLED=true

PROJECT_API_KEY_PREFIX=tg_live_
PROJECT_API_KEY_BYTES=32
REQUIRE_PROJECT_AUTHENTICATION=true

ADMIN_API_KEY_HASH=
ADMIN_API_KEY_PREFIX=tg_admin_
REQUIRE_ADMIN_AUTHENTICATION=true

TOKEN_GUARD_API_BASE_URL=http://127.0.0.1:8000

CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1700
CELERY_RESULT_EXPIRES_SECONDS=86400

ENABLE_STREAMING=true
STREAM_HEARTBEAT_SECONDS=15

JOB_RESULT_RETENTION_DAYS=7
REQUEST_LOG_RETENTION_DAYS=90
CACHE_CLEANUP_INTERVAL_HOURS=6
USAGE_AGGREGATION_INTERVAL_MINUTES=15

POLICY_ENFORCEMENT_ENABLED=true
POLICY_FILE=config/governance_policy.json

PROMPT_INJECTION_DETECTION_ENABLED=true
PROMPT_INJECTION_BLOCK_THRESHOLD=80
PROMPT_INJECTION_REVIEW_THRESHOLD=45

PII_DETECTION_ENABLED=true
PII_DEFAULT_ACTION=redact
PII_SCORE_THRESHOLD=0.6

INPUT_MODERATION_ENABLED=false
OUTPUT_MODERATION_ENABLED=false
OPENAI_MODERATION_MODEL=omni-moderation-latest

OUTPUT_SECRET_SCAN_ENABLED=true
STORE_RAW_SECURITY_CONTENT=false

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=tokenguard
JWT_AUDIENCE=tokenguard-api

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

AUTHENTICATION_ENABLED=true
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=20

CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOWED_HOSTS=*
ENABLE_DOCS=
FORCE_HTTPS_REDIRECT=false