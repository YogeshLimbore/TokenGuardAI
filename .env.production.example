# Production environment template.
#
#   cp .env.production.example .env.production
#
# Then fill in every value marked `replace_me`. Never commit .env.production:
# it is covered by .gitignore and by a .gitleaks.toml rule.
#
# Only the settings that differ from .env.example or that must be set for a
# public deployment are listed here. Anything absent falls back to the
# defaults in app/core/config.py.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_NAME=TokenGuard AI
APP_VERSION=1.5.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Interactive API docs are disabled in production. Set to true only if you
# intentionally want /docs reachable.
ENABLE_DOCS=false

# ---------------------------------------------------------------------------
# Public hostnames and TLS
# ---------------------------------------------------------------------------
# Used by the Caddy reverse proxy (deploy/Caddyfile) and by the API's
# trusted-host middleware. ALLOWED_HOSTS must not be "*" in production.
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=dashboard.example.com
TLS_CONTACT_EMAIL=ops@example.com

ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
FORCE_HTTPS_REDIRECT=true

# ---------------------------------------------------------------------------
# Container images
# ---------------------------------------------------------------------------
# Published by .github/workflows/docker.yml. Pin an immutable version tag
# rather than `latest` so a rollback is a one-line change.
TOKEN_GUARD_API_IMAGE=ghcr.io/your-org/tokenguardai/api:1.5.0
TOKEN_GUARD_DASHBOARD_IMAGE=ghcr.io/your-org/tokenguardai/dashboard:1.5.0

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
# The Compose overlay builds DATABASE_URL, REDIS_URL, and the Celery URLs
# from these values, so the credentials appear exactly once.
POSTGRES_DB=tokenguard
POSTGRES_USER=tokenguard
POSTGRES_PASSWORD=replace_me
REDIS_PASSWORD=replace_me

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# TOKEN_GUARD_MASTER_KEY encrypts every stored provider credential. Losing it
# makes those credentials unrecoverable, and rotating it requires a planned
# re-encryption migration. Back it up in a secrets manager, separately from
# the database backups.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_GUARD_MASTER_KEY=replace_me

# Rotating this invalidates every issued access token.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_me

JWT_ALGORITHM=HS256
JWT_ISSUER=tokenguard
JWT_AUDIENCE=tokenguard-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Emergency break-glass key. Prefer per-user JWT auth; see
# docs/migration-admin-to-jwt.md.
#   uv run python scripts/generate_admin_key.py
ADMIN_API_KEY_HASH=
REQUIRE_ADMIN_AUTHENTICATION=true

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
AUTHENTICATION_ENABLED=true
REQUIRE_PROJECT_AUTHENTICATION=true
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=true

# Used once by scripts/bootstrap_admin.py, then clear them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Enforcement
# ---------------------------------------------------------------------------
POLICY_ENFORCEMENT_ENABLED=true
BUDGET_ENFORCEMENT_ENABLED=true
RATE_LIMITING_ENABLED=true

PROMPT_INJECTION_DETECTION_ENABLED=true
PII_DETECTION_ENABLED=true
PII_DEFAULT_ACTION=redact
OUTPUT_SECRET_SCAN_ENABLED=true

# Keep false so flagged prompts and responses are never persisted verbatim.
STORE_RAW_SECURITY_CONTENT=false

# Provider-side moderation costs an extra API call per request and needs
# OPENAI_API_KEY to be set.
INPUT_MODERATION_ENABLED=false
OUTPUT_MODERATION_ENABLED=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
ENABLE_PROMETHEUS_METRICS=true
ENABLE_OPENTELEMETRY=true
OTEL_SERVICE_NAME=tokenguard-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# Per-project credentials stored through /v1/credentials are encrypted and
# take precedence. These are only fallbacks for unscoped requests; leave them
# blank if every project supplies its own credential.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Point at a reachable Ollama host, or disable the local route in
# config/routing_policy.json if you do not run one.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
# Request logs may be subject to audit or compliance retention rules.
# Review before lowering.
REQUEST_LOG_RETENTION_DAYS=90
JOB_RESULT_RETENTION_DAYS=7
